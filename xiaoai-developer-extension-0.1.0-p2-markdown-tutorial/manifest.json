{
  "manifest_version": 3,
  "name": "小爱伴侣-开发者工具",
  "description": "开发、测试并提交小爱与拾光课表适配器",
  "version": "0.1.0",
  "minimum_chrome_version": "135",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "userScripts"
  ],
  "host_permissions": [
    "https://api.alyfk.cn/*",
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开小爱伴侣-开发者工具",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-side-panel": {
      "description": "打开小爱伴侣-开发者工具",
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      }
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'none'; img-src 'none'; media-src 'none'; font-src 'none'; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
